{
  "name": "@agentskillmania/agenui",
  "version": "0.9.10",
  "description": "AGenUI Web Platform SDK — React + antd + antv rendering for A2UI protocol",
  "type": "module",
  "main": "./dist/agenui-web.cjs.js",
  "module": "./dist/agenui-web.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/agenui-web.es.js",
      "require": "./dist/agenui-web.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/agenui_parser.wasm": "./dist/agenui_parser.wasm"
  },
  "sideEffects": [
    "dist/agenui-web.*.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && npm run copy:wasm",
    "copy:wasm": "cp src/bridge/agenui_parser.wasm dist/agenui_parser.wasm",
    "build:wasm": "bash wasm/build.sh",
    "build:all": "npm run build:wasm && npm run build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build:all"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "antd": "^5.15.0",
    "@ant-design/icons": "^5.3.0",
    "@antv/g2plot": "^2.4.31",
    "dayjs": "^1.11.0",
    "lottie-react": "^2.4.0",
    "react-markdown": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "agenui",
    "a2ui",
    "react",
    "antd",
    "antv",
    "webassembly",
    "streaming-ui"
  ],
  "license": "Apache-2.0"
}
